# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Where each value comes from:
#   BOOKER_* and UI_BASE_URL  - the assignment brief
#   GRAPHQL_ENDPOINT          - the Hygraph GraphQL playground: select the
#                               Video Streaming example schema and read the
#                               request URL from the browser network panel.
#
# Any value can also be supplied as an environment variable of the same name,
# or as a system property (-Dbooker.base.url=...). That is how CI runs.

# --- Restful Booker ---
BOOKER_BASE_URL=<booker-base-url>
BOOKER_USERNAME=<booker-username>
BOOKER_PASSWORD=<booker-password>

# --- Hygraph GraphQL ---
GRAPHQL_ENDPOINT=<hygraph-content-api-endpoint>

# --- DemoQA UI ---
UI_BASE_URL=<demoqa-base-url>

# --- Optional. Defaults shown; uncomment to override. ---
# UI_BROWSER=chromium
# UI_HEADLESS=true      # set false to watch the browser locally
# HTTP_TIMEOUT_MS=30000
