# Lombok configuration for the whole project.
config.stopBubbling = true

# @Jacksonized must target Jackson 2 (com.fasterxml.jackson), the only Jackson
# this project uses. Left to detect it, Lombok 1.18.48 reports "Jackson2 and
# Jackson3 exist" on every @Jacksonized class, although no Jackson 3 class is
# on the classpath.
lombok.jacksonized.jacksonVersion += 2
